<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"><DataSources><DataSource Name="CompanyManagementDS"><DataSourceReference>/DataSources/CompanyManagementDS</DataSourceReference></DataSource></DataSources><DataSets><DataSet Name="Ingresos"><Query><DataSourceName>CompanyManagementDS</DataSourceName><CommandText>SELECT c.Nombre,c.Email,SUM(o.MontoTotal) AS MontoTotal FROM Clientes c INNER JOIN Ordenes o ON o.ClienteId=c.Id GROUP BY c.Nombre,c.Email ORDER BY c.Nombre</CommandText></Query><Fields><Field Name="Nombre"><DataField>Nombre</DataField></Field><Field Name="Email"><DataField>Email</DataField></Field><Field Name="MontoTotal"><DataField>MontoTotal</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Titulo"><Value>Ingresos por Cliente</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="Nota"><Top>0.4in</Top><Value>= "Ejecutado: " &amp; Globals!ExecutionTime</Value></Textbox></ReportItems><Height>1in</Height></Body><Width>6in</Width><Page><PageFooter><Height>0.25in</Height><ReportItems><Textbox Name="Pie"><Value>="Página " &amp; Globals!PageNumber</Value></Textbox></ReportItems></PageFooter></Page></ReportSection></ReportSections></Report>
