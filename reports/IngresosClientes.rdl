<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSources>
    <DataSource Name="CompanyManagementDS">
      <DataSourceReference>/DataSources/CompanyManagementDS</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS">
      <Query>
        <DataSourceName>CompanyManagementDS</DataSourceName>
        <CommandText>SELECT c.Nombre,c.Email,SUM(o.MontoTotal) MontoTotal FROM Clientes c JOIN Ordenes o ON o.ClienteId=c.Id GROUP BY c.Nombre,c.Email</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Email">
          <DataField>Email</DataField>
        </Field>
        <Field Name="MontoTotal">
          <DataField>MontoTotal</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Titulo">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Ingresos por Cliente</Value>
                    <Style>
                      <FontSize>18pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.3in</Height>
            <Width>6in</Width>
