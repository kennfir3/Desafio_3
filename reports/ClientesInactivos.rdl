<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"><DataSources><DataSource Name="CompanyManagementDS"><DataSourceReference>/DataSources/CompanyManagementDS</DataSourceReference></DataSource></DataSources><DataSets><DataSet Name="Inactivos"><Query><DataSourceName>CompanyManagementDS</DataSourceName><CommandText>SELECT c.Nombre,c.Email,c.FechaRegistro FROM Clientes c WHERE c.FechaRegistro &gt;= DATEADD(month,-1,GETUTCDATE()) AND NOT EXISTS(SELECT 1 FROM Ordenes o WHERE o.ClienteId=c.Id) ORDER BY c.FechaRegistro DESC</CommandText></Query><Fields><Field Name="Nombre"><DataField>Nombre</DataField></Field><Field Name="Email"><DataField>Email</DataField></Field><Field Name="FechaRegistro"><DataField>FechaRegistro</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Titulo"><Value>Clientes Inactivos</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="Fecha"><Top>0.4in</Top><Value>= "Ejecutado: " &amp; Globals!ExecutionTime</Value></Textbox></ReportItems><Height>1in</Height></Body><Width>6in</Width><Page><PageFooter><Height>0.25in</Height><ReportItems><Textbox Name="Pie"><Value>="Página " &amp; Globals!PageNumber</Value></Textbox></ReportItems></PageFooter></Page></ReportSection></ReportSections></Report>
