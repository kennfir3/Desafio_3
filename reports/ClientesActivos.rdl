<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><DataSources><DataSource Name="CompanyManagementDS"><DataSourceReference>/DataSources/CompanyManagementDS</DataSourceReference><rd:DataSourceID>00000000-0000-0000-0000-000000000001</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="ClientesActivos"><Query><DataSourceName>CompanyManagementDS</DataSourceName><CommandText>SELECT c.Nombre,c.Email,COUNT(o.Id) AS TotalOrdenes FROM Clientes c INNER JOIN Ordenes o ON o.ClienteId=c.Id GROUP BY c.Nombre,c.Email ORDER BY c.Nombre</CommandText></Query><Fields><Field Name="Nombre"><DataField>Nombre</DataField></Field><Field Name="Email"><DataField>Email</DataField></Field><Field Name="TotalOrdenes"><DataField>TotalOrdenes</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tabla"><TablixBody><TablixColumns><TablixColumn><Width>2in</Width></TablixColumn><TablixColumn><Width>2.5in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.28in</Height><TablixCells><TablixCell><CellContents><Textbox Name="N"><Value>=Fields!Nombre.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="E"><Value>=Fields!Email.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="T"><Value>=Fields!TotalOrdenes.Value</Value></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixRowHierarchy><TablixMembers><TablixMember><Group Name="Details"/></TablixMember></TablixMembers></TablixRowHierarchy><TablixColumnHierarchy><TablixMembers><TablixMember/><TablixMember/><TablixMember/></TablixMembers></TablixColumnHierarchy><DataSetName>ClientesActivos</DataSetName></Tablix></ReportItems><Height>1in</Height></Body><Width>6in</Width><Page><PageFooter><Height>0.25in</Height><ReportItems><Textbox Name="Pie"><Value>="Página " &amp; Globals!PageNumber</Value></Textbox></ReportItems></PageFooter></Page></ReportSection></ReportSections></Report>
